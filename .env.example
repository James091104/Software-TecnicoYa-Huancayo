# Base de Datos (PostgreSQL en vm703 / 192.168.0.203)
DB_CONNECTION=postgresql
DB_HOST=192.168.0.203
DB_PORT=5432
DB_NAME=laboratorio_db
DB_USER=postgres_admin
DB_PASSWORD=secret_password

# Puertos asignados por el framework
FRONTEND_PORT=4200
BACKEND_PORT=3000
PYTHON_PORT=8000
