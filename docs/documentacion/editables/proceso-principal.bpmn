<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="TecnicoYaDefinitions" targetNamespace="https://tecnicoya.example/bpmn"><bpmn:process id="ProcesoPrincipal" name="TécnicoYa camino principal para revisión" isExecutable="false"><bpmn:startEvent id="inicio" name="Necesidad de servicio" /><bpmn:task id="solicitud" name="Cliente registra solicitud" /><bpmn:task id="ranking" name="Sistema ordena candidatos" /><bpmn:task id="oferta" name="Sistema genera ofertas" /><bpmn:task id="acepta" name="Técnico acepta" /><bpmn:task id="confirma" name="Cliente confirma" /><bpmn:task id="ejecuta" name="Técnico ejecuta y finaliza" /><bpmn:task id="nota" name="Cliente califica" /><bpmn:endEvent id="fin" name="Servicio evaluado" /><bpmn:sequenceFlow id="f0" sourceRef="inicio" targetRef="solicitud" /><bpmn:sequenceFlow id="f1" sourceRef="solicitud" targetRef="ranking" /><bpmn:sequenceFlow id="f2" sourceRef="ranking" targetRef="oferta" /><bpmn:sequenceFlow id="f3" sourceRef="oferta" targetRef="acepta" /><bpmn:sequenceFlow id="f4" sourceRef="acepta" targetRef="confirma" /><bpmn:sequenceFlow id="f5" sourceRef="confirma" targetRef="ejecuta" /><bpmn:sequenceFlow id="f6" sourceRef="ejecuta" targetRef="nota" /><bpmn:sequenceFlow id="f7" sourceRef="nota" targetRef="fin" /></bpmn:process><bpmndi:BPMNDiagram id="diagrama"><bpmndi:BPMNPlane id="plano" bpmnElement="ProcesoPrincipal"><bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio"><dc:Bounds x="30" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="solicitud_di" bpmnElement="solicitud"><dc:Bounds x="185" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="ranking_di" bpmnElement="ranking"><dc:Bounds x="340" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="oferta_di" bpmnElement="oferta"><dc:Bounds x="495" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="acepta_di" bpmnElement="acepta"><dc:Bounds x="650" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="confirma_di" bpmnElement="confirma"><dc:Bounds x="805" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="ejecuta_di" bpmnElement="ejecuta"><dc:Bounds x="960" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="nota_di" bpmnElement="nota"><dc:Bounds x="1115" y="80" width="120" height="70" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="fin_di" bpmnElement="fin"><dc:Bounds x="1270" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="66" y="110" /><di:waypoint x="185" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="305" y="110" /><di:waypoint x="340" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="460" y="110" /><di:waypoint x="495" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="615" y="110" /><di:waypoint x="650" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="770" y="110" /><di:waypoint x="805" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="925" y="110" /><di:waypoint x="960" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="1080" y="110" /><di:waypoint x="1115" y="110" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1235" y="110" /><di:waypoint x="1270" y="110" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>